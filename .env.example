# Trustpilot brands to monitor (comma-separated)
BRANDS=ketogo.app

# JWT access token for Trustpilot authentication
JWT_ACCESS_TOKEN=XXXX.YYYY.ZZZZ;

# Maximum pages to scrape for daily updates (10 pages max for public unauthenticated access)
MAX_PAGES=10

# Google Drive settings (optional - ignore these for minimal setup)
GOOGLE_DRIVE_FOLDER_ID=
KEEP_INDIVIDUAL_PDFS=false